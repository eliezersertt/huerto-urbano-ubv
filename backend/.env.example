# == Entorno ==
ENVIRONMENT=development
DEBUG=true

# == Base de datos (Supabase) ==
# Usa el pooler (IPv4), no la conexion directa (solo IPv6).
# Formato: postgresql+psycopg://postgres.<ref>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# == CORS ==
# "*" permite cualquier origen (temporal, para el frontend en Vercel).
CORS_ORIGINS=["*"]

# == URL publica para los codigos QR ==
# En produccion debe ser la URL del frontend (Vercel).
PUBLIC_BASE_URL=http://localhost:5173
